var QUESTION_DATA = QUESTION_BANK.slice();    // live working order for the current attempt

/* ================= SHUFFLE HELPERS ================= */
function shuffleArray(arr){
  var a = arr.slice();
  for(var i=a.length-1;i>0;i--){
    var j = Math.floor(Math.random()*(i+1));
    var tmp = a[i]; a[i]=a[j]; a[j]=tmp;
  }
  return a;
}

// Builds a fresh quiz order: subject blocks stay in exam order (CDP, TEL,
// ENG, MATH, PSCI, BIO), but the questions WITHIN each subject are shuffled,
// and each question's own options are shuffled too (with the correct-answer
// indices remapped to match). Called once per attempt.
function buildShuffledQuiz(){
  var quiz = [];
  SUBJECT_ORDER.forEach(function(code){
    var subjQuestions = QUESTION_BANK.filter(function(q){ return q.subject===code; });
    var shuffledQuestions = shuffleArray(subjQuestions);
    shuffledQuestions.forEach(function(q){
      var optOrder = shuffleArray(q.opts.map(function(_,idx){ return idx; }));
      var newOpts = optOrder.map(function(oi){ return q.opts[oi]; });
      var newCorrect = q.correct.map(function(ci){ return optOrder.indexOf(ci); });
      quiz.push({ subject:q.subject, en:q.en, te:q.te, opts:newOpts, correct:newCorrect });
    });
  });
  return quiz;
}

/* ================= STATE ================= */
var state = {
  name:"",
  current:0,
  responses:new Array(QUESTION_DATA.length).fill(null),
  visited:new Array(QUESTION_DATA.length).fill(false),
  seconds:0,
  timerId:null,
  submitted:false,
  lbPollId:null
};

/* ================= HELPERS ================= */
function $(id){ return document.getElementById(id); }
function esc(s){ return (s===undefined||s===null) ? "" : s; }
function pad2(n){ return n<10 ? "0"+n : ""+n; }
function fmtTime(sec){ var m=Math.floor(sec/60); var s=sec%60; return pad2(m)+":"+pad2(s); }

function subjectIndices(code){
  var arr=[];
  for(var i=0;i<QUESTION_DATA.length;i++){ if(QUESTION_DATA[i].subject===code) arr.push(i); }
  return arr;
}
var SUBJECT_INDEX_MAP = {};
SUBJECT_ORDER.forEach(function(c){ SUBJECT_INDEX_MAP[c]=subjectIndices(c); });

// Rebuilds everything that depends on question order/answers for a brand
// new attempt: reshuffles questions+options, resets responses/visited, and
// refreshes the subject->index lookup used by navigation & the palette.
function startNewAttempt(){
  QUESTION_DATA = buildShuffledQuiz();
  state.current = 0;
  state.responses = new Array(QUESTION_DATA.length).fill(null);
  state.visited = new Array(QUESTION_DATA.length).fill(false);
  state.seconds = 0;
  state.submitted = false;
  SUBJECT_ORDER.forEach(function(c){ SUBJECT_INDEX_MAP[c] = subjectIndices(c); });
}

function computeScore(){
  var correct=0, wrong=0, attempted=0;
  for(var i=0;i<QUESTION_DATA.length;i++){
    var r = state.responses[i];
    if(r!==null){
      attempted++;
      if(QUESTION_DATA[i].correct.indexOf(r)!==-1) correct++; else wrong++;
    }
  }
  return {correct:correct, wrong:wrong, attempted:attempted, unattempted:QUESTION_DATA.length-attempted};
}

function subjectScore(code){
  var idxs = SUBJECT_INDEX_MAP[code];
  var correct=0, attempted=0;
  idxs.forEach(function(i){
    var r=state.responses[i];
    if(r!==null){ attempted++; if(QUESTION_DATA[i].correct.indexOf(r)!==-1) correct++; }
  });
  return {correct:correct, total:idxs.length, attempted:attempted};
}

/* ================= START SCREEN ================= */
function buildSubjectStrip(){
  var grid = $('subjectStripGrid');
  grid.innerHTML = "";
  SUBJECT_ORDER.forEach(function(code){
    var s = SUBJECTS[code];
    var cnt = SUBJECT_INDEX_MAP[code].length;
    var div = document.createElement('div');
    div.className = 'subject-chip';
    div.innerHTML = '<div class="dot" style="background:'+s.color+'"></div>' +
      '<div class="nm">'+s.short+'</div><div class="cnt">'+cnt+' Qs</div>';
    grid.appendChild(div);
  });
}

function buildSubjectNav(){
  var nav = $('subjectNav');
  nav.innerHTML = "";
  SUBJECT_ORDER.forEach(function(code){
    var s = SUBJECTS[code];
    var btn = document.createElement('button');
    btn.textContent = s.short;
    btn.dataset.subject = code;
    btn.addEventListener('click', function(){
      var idxs = SUBJECT_INDEX_MAP[code];
      // jump to first unanswered question in this subject, else its first question
      var target = idxs[0];
      for(var k=0;k<idxs.length;k++){ if(state.responses[idxs[k]]===null){ target=idxs[k]; break; } }
      goTo(target);
    });
    nav.appendChild(btn);
  });
}

$('startBtn').addEventListener('click', function(){
  var val = $('nameInput').value.trim();
  if(!val){ $('nameErr').style.display='block'; return; }
  $('nameErr').style.display='none';
  state.name = val;
  startNewAttempt();
  $('startScreen').style.display='none';
  $('testScreen').style.display='block';
  startTimer();
  goTo(0);
});
$('nameInput').addEventListener('keydown', function(e){ if(e.key==='Enter'){ $('startBtn').click(); } });

/* ================= TIMER ================= */
function startTimer(){
  state.timerId = setInterval(function(){
    state.seconds++;
    $('timerDisplay').textContent = fmtTime(state.seconds);
  }, 1000);
}
function stopTimer(){ if(state.timerId){ clearInterval(state.timerId); state.timerId=null; } }

/* ================= RENDER QUESTION ================= */
function goTo(i){
  state.current = i;
  state.visited[i] = true;
  renderQuestion();
  renderPalette();
  closeMobilePalette();
  window.scrollTo({top:0, behavior:'smooth'});
}

function optionLine(opt){
  var hasEn = opt.en && opt.en.length;
  var hasTe = opt.te && opt.te.length;
  if(hasEn && hasTe && opt.en!==opt.te){
    return '<span class="oen">'+esc(opt.en)+'</span><span class="te">'+esc(opt.te)+'</span>';
  }
  return '<span>'+esc(hasEn?opt.en:opt.te)+'</span>';
}

function renderQuestion(){
  var i = state.current;
  var q = QUESTION_DATA[i];
  var s = SUBJECTS[q.subject];
  var idxs = SUBJECT_INDEX_MAP[q.subject];
  var localNo = idxs.indexOf(i)+1;
  var response = state.responses[i];

  var head = '<div class="qcard-head">' +
      '<div><span class="subject-pill" style="background:'+s.color+'22;color:'+s.color+';border:1px solid '+s.color+'55;">'+s.short+'</span> ' +
      '<span class="qno">Question '+(i+1)+' of '+QUESTION_DATA.length+'</span></div>' +
      '<div class="paperline">'+PAPER_LABEL+' &mdash; '+s.label+' (Q'+localNo+' of '+idxs.length+')</div>' +
    '</div>';

  var qHtml = '';
  if(q.en) qHtml += '<div class="qtext">'+q.en+'</div>';
  if(q.te) qHtml += '<div class="qtext te">'+q.te+'</div>';

  var optsHtml = '<div class="opts">';
  var tagLetters = ['A','B','C','D','E','F'];
  q.opts.forEach(function(opt, j){
    var cls = 'opt';
    if(response!==null){
      cls += ' locked';
      if(q.correct.indexOf(j)!==-1) cls += ' correct';
      else if(j===response) cls += ' wrong';
    }
    optsHtml += '<div class="'+cls+'" data-idx="'+j+'">' +
      '<div class="tag">'+tagLetters[j]+'</div>' +
      '<div class="otext">'+optionLine(opt)+'</div>' +
    '</div>';
  });
  optsHtml += '</div>';

  var nav = '<div class="qcard-nav">' +
      '<button class="btn btn-ghost" id="prevBtn" '+(i===0?'disabled':'')+'>&larr; Previous</button>' +
      '<div class="right-btns">' +
        '<button class="btn btn-outline" id="submitInlineBtn">Submit Test</button>' +
        (i===QUESTION_DATA.length-1
          ? ''
          : '<button class="btn btn-primary" id="nextBtn">Next &rarr;</button>') +
      '</div>' +
    '</div>';

  $('qcard').innerHTML = head + qHtml + optsHtml + nav;

  if(response===null){
    Array.prototype.forEach.call($('qcard').querySelectorAll('.opt'), function(el){
      el.addEventListener('click', function(){
        selectOption(i, parseInt(el.dataset.idx,10));
      });
    });
  }
  $('prevBtn').addEventListener('click', function(){ if(i>0) goTo(i-1); });
  $('submitInlineBtn').addEventListener('click', tryFinalSubmit);
  var nextBtnEl = $('nextBtn');
  if(nextBtnEl){
    nextBtnEl.addEventListener('click', function(){ goTo(i+1); });
  }

  updateSubjectNavActive(q.subject);
  updateScoreDisplay();
}

function selectOption(i, j){
  if(state.responses[i]!==null) return;
  state.responses[i] = j;
  renderQuestion();
  renderPalette();
}

function updateSubjectNavActive(code){
  Array.prototype.forEach.call(document.querySelectorAll('#subjectNav button'), function(b){
    b.classList.toggle('active', b.dataset.subject===code);
  });
}

function updateScoreDisplay(){
  var sc = computeScore();
  $('liveScore').textContent = sc.correct;
  $('liveAttempted').textContent = sc.attempted;
}

/* ================= PALETTE ================= */
function buildPaletteHtml(){
  var html = '<h4>Question Palette</h4>' +
    '<div class="legend">' +
      '<span><i style="background:var(--navy-700);border:1px solid var(--line);"></i>Not visited</span>' +
      '<span><i style="background:var(--blue-dim);"></i>Answered</span>' +
      '<span><i style="background:var(--yellow-dim);"></i>Skipped</span>' +
    '</div>';
  SUBJECT_ORDER.forEach(function(code){
    var s = SUBJECTS[code];
    var idxs = SUBJECT_INDEX_MAP[code];
    html += '<div class="pal-group"><div class="glabel">'+s.short+' ('+(idxs[0]+1)+'\u2013'+(idxs[idxs.length-1]+1)+')</div><div class="pal-grid">';
    idxs.forEach(function(i){
      var cls = 'pal-btn';
      if(state.responses[i]!==null) cls += ' answered';
      else if(state.visited[i]) cls += ' skipped';
      if(i===state.current) cls += ' current';
      html += '<button class="'+cls+'" data-i="'+i+'">'+(i+1)+'</button>';
    });
    html += '</div></div>';
  });
  html += '<button class="btn btn-primary submit-final submitFinalBtn">Submit Test</button>';
  return html;
}

function renderPalette(){
  var html = buildPaletteHtml();
  $('paletteDesktop').innerHTML = html;
  $('paletteMobile').innerHTML = html;
  bindPaletteEvents($('paletteDesktop'));
  bindPaletteEvents($('paletteMobile'));
}

function bindPaletteEvents(container){
  Array.prototype.forEach.call(container.querySelectorAll('.pal-btn'), function(btn){
    btn.addEventListener('click', function(){ goTo(parseInt(btn.dataset.i,10)); });
  });
  var sb = container.querySelector('.submitFinalBtn');
  if(sb) sb.addEventListener('click', tryFinalSubmit);
}

$('paletteToggleBtn').addEventListener('click', function(){
  $('paletteOverlay').classList.add('show');
});
$('paletteOverlay').addEventListener('click', function(e){
  if(e.target.id==='paletteOverlay') closeMobilePalette();
});
$('closePaletteBtn').addEventListener('click', closeMobilePalette);
function closeMobilePalette(){ $('paletteOverlay').classList.remove('show'); }

/* ================= SUBMIT FLOW ================= */
function tryFinalSubmit(){
  var sc = computeScore();
  if(sc.unattempted>0){
    $('submitModalText').textContent = 'You still have '+sc.unattempted+' unanswered question(s) out of '+QUESTION_DATA.length+'.';
  } else {
    $('submitModalText').textContent = 'You have answered all '+QUESTION_DATA.length+' questions.';
  }
  $('submitModal').style.display='flex';
}
$('cancelSubmitBtn').addEventListener('click', function(){ $('submitModal').style.display='none'; });
$('confirmSubmitBtn').addEventListener('click', function(){
  $('submitModal').style.display='none';
  finalizeSubmit();
});

function finalizeSubmit(){
  state.submitted = true;
  stopTimer();
  $('testScreen').style.display='none';
  $('resultScreen').style.display='block';
  renderResult();
  submitScoreToBackend();
}

/* ================= RESULT SCREEN ================= */
function renderResult(){
  var sc = computeScore();
  var pct = Math.round((sc.correct/QUESTION_DATA.length)*100);
  $('resultName').textContent = state.name + ', here is your result';
  $('scoreRing').style.setProperty('--pct', pct);
  $('scoreRingVal').textContent = sc.correct+'/'+QUESTION_DATA.length;
  $('rCorrect').textContent = sc.correct;
  $('rWrong').textContent = sc.wrong;
  $('rSkip').textContent = sc.unattempted;
  $('rTime').textContent = fmtTime(state.seconds);

  var bd = $('subjectBreakdownList');
  bd.innerHTML = "";
  SUBJECT_ORDER.forEach(function(code){
    var s = SUBJECTS[code];
    var ss = subjectScore(code);
    var pctS = ss.total ? Math.round((ss.correct/ss.total)*100) : 0;
    var row = document.createElement('div');
    row.className = 'sb-row';
    row.innerHTML = '<div>'+s.label+'</div>' +
      '<div style="font-family:var(--font-mono);color:'+s.color+';font-weight:700;">'+ss.correct+'/'+ss.total+'</div>' +
      '<div class="sb-bar-track"><div class="sb-bar-fill" style="width:'+pctS+'%;background:'+s.color+';"></div></div>';
    bd.appendChild(row);
  });
}

$('viewKeyBtn').addEventListener('click', function(){
  $('keySection').classList.toggle('hidden');
  if(!$('keySection').classList.contains('hidden')){
    renderAnswerKey();
    $('keySection').scrollIntoView({behavior:'smooth'});
  }
});

$('viewLbBtn').addEventListener('click', function(){
  $('lbSection').classList.toggle('hidden');
  if(!$('lbSection').classList.contains('hidden')){
    fetchLeaderboard();
    startLbPolling();
    $('lbSection').scrollIntoView({behavior:'smooth'});
  } else {
    stopLbPolling();
  }
});

$('restartBtn').addEventListener('click', function(){
  if(!confirm('This will clear all your current answers and restart the test. Continue?')) return;
  location.reload();
});

/* ---------- Answer key ---------- */
function renderAnswerKey(){
  var list = $('keyList');
  list.innerHTML = "";
  var tagLetters = ['A','B','C','D','E','F'];
  QUESTION_DATA.forEach(function(q, i){
    var s = SUBJECTS[q.subject];
    var response = state.responses[i];
    var card = document.createElement('div');
    card.className = 'key-card';
    var badge = response===null ? '<span class="key-badge na">Unattempted</span>' :
      (q.correct.indexOf(response)!==-1 ? '<span class="key-badge ok">Your answer correct</span>' : '<span class="key-badge no">Your answer wrong</span>');
    var headHtml = '<div class="khead"><span class="subject-pill" style="background:'+s.color+'22;color:'+s.color+';border:1px solid '+s.color+'55;">'+s.short+'</span>' +
      '<span class="qno" style="font-family:var(--font-mono);color:var(--gold);font-size:12.5px;">Q'+(i+1)+'</span>' + badge + '</div>';
    var qHtml = '';
    if(q.en) qHtml += '<div class="kq">'+q.en+'</div>';
    if(q.te) qHtml += '<div class="kq te">'+q.te+'</div>';
    var optsHtml = '<div class="key-opts">';
    q.opts.forEach(function(opt, j){
      var cls = 'key-opt';
      if(q.correct.indexOf(j)!==-1) cls += ' correct';
      else if(j===response) cls += ' userwrong';
      optsHtml += '<div class="'+cls+'"><div class="tag" style="flex:0 0 auto;color:var(--ink-faint);font-weight:700;">'+tagLetters[j]+'.</div><div class="otext">'+optionLine(opt)+'</div></div>';
    });
    optsHtml += '</div>';
    card.innerHTML = headHtml + qHtml + optsHtml;
    list.appendChild(card);
  });
}

/* ================= CERTIFICATE ================= */
$('downloadCertBtn').addEventListener('click', function(){
  var sc = computeScore();
  generateCertificate(state.name, sc.correct, QUESTION_DATA.length);
});

function generateCertificate(name, score, total){
  var canvas = $('certCanvas');
  var ctx = canvas.getContext('2d');
  var W = canvas.width, H = canvas.height;

  // background
  var grad = ctx.createLinearGradient(0,0,W,H);
  grad.addColorStop(0,'#0a1226');
  grad.addColorStop(1,'#101d38');
  ctx.fillStyle = grad;
  ctx.fillRect(0,0,W,H);

  // outer gold border
  ctx.strokeStyle = '#f0b940';
  ctx.lineWidth = 10;
  ctx.strokeRect(30,30,W-60,H-60);
  ctx.strokeStyle = 'rgba(240,185,64,.5)';
  ctx.lineWidth = 2;
  ctx.strokeRect(48,48,W-96,H-96);

  // corner motifs
  ctx.fillStyle = '#f0b940';
  [[70,70],[W-70,70],[70,H-70],[W-70,H-70]].forEach(function(p){
    ctx.beginPath(); ctx.arc(p[0],p[1],7,0,Math.PI*2); ctx.fill();
  });

  ctx.textAlign = 'center';

  ctx.fillStyle = '#f0b940';
  ctx.font = '600 22px Poppins, sans-serif';
  ctx.fillText('C E R T I F I C A T E   O F   A P P R E C I A T I O N', W/2, 175);

  ctx.fillStyle = '#eaf0fb';
  ctx.font = '400 20px Poppins, sans-serif';
  ctx.fillText('This certificate is proudly presented to', W/2, 235);

  ctx.fillStyle = '#ffffff';
  ctx.font = '700 54px Georgia, "Times New Roman", serif';
  ctx.fillText(name, W/2, 320);

  // underline
  ctx.strokeStyle = '#f0b940';
  ctx.lineWidth = 2;
  var lw = Math.max(280, ctx.measureText(name).width + 60);
  ctx.beginPath();
  ctx.moveTo(W/2-lw/2, 340);
  ctx.lineTo(W/2+lw/2, 340);
  ctx.stroke();

  ctx.fillStyle = '#c7d3ec';
  ctx.font = '400 19px Poppins, sans-serif';
  wrapCenteredText(ctx, 'for successfully completing the APTET Paper-II (Mathematics & Science) Practice Test', W/2, 390, 900, 26);
  wrapCenteredText(ctx, 'based on the Previous Question Papers)', W/2, 420, 900, 26);

  ctx.fillStyle = '#f0b940';
  ctx.font = '700 40px "JetBrains Mono", monospace';
  ctx.fillText(score + ' / ' + total, W/2, 500);
  ctx.fillStyle = '#8ea0c6';
  ctx.font = '400 15px Poppins, sans-serif';
  ctx.fillText('SCORE', W/2, 525);

  var d = new Date();
  var dateStr = d.toLocaleDateString('en-IN', {day:'2-digit', month:'long', year:'numeric'});
  ctx.fillStyle = '#8ea0c6';
  ctx.font = '400 16px Poppins, sans-serif';
  ctx.fillText('Date of completion: ' + dateStr, W/2, 570);

  // credit block
  ctx.fillStyle = '#eaf0fb';
  ctx.font = '700 17px Poppins, sans-serif';
  ctx.fillText('C. RASOOL BAVAJI', W/2, 990);
  ctx.fillStyle = '#8ea0c6';
  ctx.font = '400 14px Poppins, sans-serif';
  ctx.fillText('S.A.(P.S.), ZPHS, MADANAPALLE, ANNAMAYYA DISTRICT', W/2, 1012);
  ctx.fillStyle = '#f0b940';
  ctx.font = '400 14px Poppins, sans-serif';
  ctx.fillText('https://tenthquiz.blogspot.com', W/2, 1032);

  var link = document.createElement('a');
  link.download = 'Certificate_' + name.replace(/[^a-z0-9]+/gi,'_') + '.png';
  link.href = canvas.toDataURL('image/png');
  link.click();
}

function wrapCenteredText(ctx, text, x, y, maxWidth, lineHeight){
  var words = text.split(' ');
  var line = '';
  var lines = [];
  for(var n=0;n<words.length;n++){
    var testLine = line + words[n] + ' ';
    if(ctx.measureText(testLine).width > maxWidth && n>0){
      lines.push(line);
      line = words[n] + ' ';
    } else {
      line = testLine;
    }
  }
  lines.push(line);
  var startY = y - ((lines.length-1)*lineHeight)/2;
  lines.forEach(function(l, i){ ctx.fillText(l.trim(), x, startY + i*lineHeight); });
}

/* ================= BACKEND: LEADERBOARD ================= */
function isBackendConfigured(){
  return APPS_SCRIPT_URL && APPS_SCRIPT_URL.indexOf('REPLACE_WITH')!==0;
}

function submitScoreToBackend(){
  if(!isBackendConfigured()) return;
  var sc = computeScore();
  var payload = {
    name: state.name,
    score: sc.correct,
    correct: sc.correct,
    wrong: sc.wrong,
    unattempted: sc.unattempted,
    timeTaken: state.seconds
  };
  fetch(APPS_SCRIPT_URL, {
    method:'POST',
    headers:{'Content-Type':'text/plain;charset=utf-8'},
    body: JSON.stringify(payload)
  }).catch(function(){ /* fail silently, offline-safe */ });
}

function fetchLeaderboard(){
  if(!isBackendConfigured()){
    $('lbBody').innerHTML = "";
    $('lbStatus').classList.remove('hidden');
    $('lbStatus').textContent = 'Live leaderboard is not set up yet. See the accompanying Apps Script guide to connect a free Google Sheet backend.';
    return;
  }
  fetch(APPS_SCRIPT_URL + '?action=leaderboard&t=' + Date.now())
    .then(function(r){ return r.json(); })
    .then(function(data){ renderLeaderboard(data); })
    .catch(function(){
      $('lbStatus').classList.remove('hidden');
      $('lbStatus').textContent = 'Could not load the leaderboard right now. It will retry automatically.';
    });
}

function renderLeaderboard(data){
  $('lbStatus').classList.add('hidden');
  var body = $('lbBody');
  body.innerHTML = "";
  if(!data || !data.length){
    $('lbStatus').classList.remove('hidden');
    $('lbStatus').textContent = 'No entries yet \u2014 be the first on the leaderboard!';
    return;
  }
  data.forEach(function(row, i){
    var isMe = row.name === state.name && Number(row.score) === computeScore().correct;
    var tr = document.createElement('tr');
    if(isMe) tr.className = 'me';
    tr.innerHTML = '<td class="lb-rank">'+(i+1)+'</td><td>'+esc(row.name)+'</td><td>'+esc(row.score)+' / '+QUESTION_DATA.length+'</td><td>'+fmtTime(Number(row.timeTaken)||0)+'</td>';
    body.appendChild(tr);
  });
}

function startLbPolling(){
  stopLbPolling();
  state.lbPollId = setInterval(fetchLeaderboard, 20000);
}
function stopLbPolling(){ if(state.lbPollId){ clearInterval(state.lbPollId); state.lbPollId=null; } }

/* ================= INIT ================= */
buildSubjectStrip();
buildSubjectNav();
renderPalette();

})();
</script>
