  <div class="testbar">
    <div class="testbar-inner">
      <div class="timer-box">&#9201; <span id="timerDisplay">00:00</span></div>
      <div class="subject-nav" id="subjectNav"></div>
      <div class="score-box">Score: <b id="liveScore">0</b> / <span id="liveAttempted">0</span> attempted</div>
      <button class="palette-toggle" id="paletteToggleBtn">&#9776; Questions</button>
    </div>
  </div>

  <div class="test-body">
    <div class="qcard" id="qcard"></div>

    <div class="palette" id="paletteDesktop"></div>
  </div>
