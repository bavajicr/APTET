<style>
:root{
  --navy-950:#060b18;
  --navy-900:#0a1226;
  --navy-800:#101d38;
  --navy-700:#152548;
  --navy-600:#1c3159;
  --navy-500:#28417a;
  --line:#25355e;
  --ink:#eaf0fb;
  --ink-dim:#a9b8d8;
  --ink-faint:#7386ac;
  --gold:#f0b940;
  --gold-dim:#c99a3b;
  --blue:#3b7dff;
  --blue-dim:#2e5fc4;
  --green:#22c774;
  --green-dim:#12693e;
  --red:#ff5468;
  --red-dim:#7a1f2b;
  --yellow:#f0c33e;
  --yellow-dim:#7a5f11;
  --radius:14px;
  --shadow: 0 10px 30px rgba(0,0,0,.35);
  --font-display:'Poppins',sans-serif;
  --font-body:'Poppins','Noto Sans Telugu',sans-serif;
  --font-mono:'JetBrains Mono',monospace;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:
    radial-gradient(1200px 600px at 15% -10%, #12224a 0%, transparent 60%),
    radial-gradient(1000px 700px at 110% 10%, #0e1c3c 0%, transparent 55%),
    var(--navy-950);
  color:var(--ink);
  font-family:var(--font-body);
  min-height:100vh;
  line-height:1.5;
}
::selection{background:var(--blue-dim);color:#fff;}
.te{font-family:'Noto Sans Telugu','Poppins',sans-serif;}
a{color:var(--gold);}
button{font-family:inherit;}
.hidden{display:none !important;}
.wrap{max-width:1180px;margin:0 auto;padding:0 18px;}

/* ---------- Top brand strip ---------- */
.brandbar{
  border-bottom:1px solid var(--line);
  background:linear-gradient(180deg, rgba(16,29,56,.9), rgba(10,18,38,.6));
  padding:10px 0;
}
.brandbar .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}
.brand{display:flex;align-items:center;gap:10px;}
.brand-badge{
  width:38px;height:38px;border-radius:10px;
  background:conic-gradient(from 210deg, var(--gold), #ffe6a8, var(--gold));
  display:flex;align-items:center;justify-content:center;
  font-weight:800;color:#1a1200;font-size:15px;font-family:var(--font-display);
  box-shadow:0 4px 14px rgba(240,185,64,.35);
}
.brand-text .t1{font-weight:700;font-size:14.5px;letter-spacing:.2px;}
.brand-text .t2{font-size:11.5px;color:var(--ink-faint);}
.brandbar .credit{font-size:11.5px;color:var(--ink-faint);text-align:right;}
.brandbar .credit b{color:var(--ink-dim);}

/* ============ START SCREEN ============ */
#startScreen{padding:34px 0 60px;}
.hero{
  text-align:center;padding:28px 18px 8px;
}
.hero .eyebrow{
  display:inline-block;font-family:var(--font-mono);font-size:11.5px;letter-spacing:2px;
  color:var(--gold);text-transform:uppercase;border:1px solid var(--gold-dim);
  padding:5px 12px;border-radius:100px;margin-bottom:16px;background:rgba(240,185,64,.06);
}
.hero h1{font-family:var(--font-display);font-size:clamp(24px,4vw,38px);margin:0 0 10px;font-weight:800;letter-spacing:-.3px;}
.hero p.sub{color:var(--ink-dim);font-size:15px;max-width:640px;margin:0 auto;}

.stat-row{
  display:grid;grid-template-columns:repeat(4,1fr);gap:12px;max-width:760px;margin:26px auto 0;
}
.stat-card{background:var(--navy-800);border:1px solid var(--line);border-radius:var(--radius);padding:14px 10px;text-align:center;}
.stat-card .num{font-family:var(--font-mono);font-size:22px;font-weight:700;color:var(--gold);}
.stat-card .lbl{font-size:11px;color:var(--ink-faint);margin-top:2px;}

.subject-strip{max-width:900px;margin:30px auto 0;padding:0 12px;}
.subject-strip h3{text-align:center;font-size:13px;text-transform:uppercase;letter-spacing:1.5px;color:var(--ink-faint);margin-bottom:14px;font-weight:600;}
.subject-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;}
.subject-chip{
  background:var(--navy-800);border:1px solid var(--line);border-radius:12px;padding:12px 6px;text-align:center;
}
.subject-chip .dot{width:9px;height:9px;border-radius:50%;margin:0 auto 8px;}
.subject-chip .nm{font-size:12px;font-weight:600;}
.subject-chip .cnt{font-size:11px;color:var(--ink-faint);margin-top:2px;}

.start-form{
  max-width:460px;margin:34px auto 0;background:var(--navy-800);border:1px solid var(--line);
  border-radius:var(--radius);padding:26px 24px;box-shadow:var(--shadow);
}
.start-form label{display:block;font-size:12.5px;color:var(--ink-dim);margin-bottom:7px;font-weight:600;}
.start-form input[type=text]{
  width:100%;padding:12px 14px;border-radius:10px;border:1px solid var(--line);
  background:var(--navy-900);color:var(--ink);font-size:15px;outline:none;
}
.start-form input[type=text]:focus{border-color:var(--blue);}
.start-form .hint{font-size:11.5px;color:var(--ink-faint);margin-top:6px;}
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  border:none;border-radius:11px;padding:13px 22px;font-weight:700;font-size:14.5px;
  cursor:pointer;transition:transform .12s ease, box-shadow .12s ease;
}
.btn:active{transform:scale(.98);}
.btn-primary{background:linear-gradient(135deg,var(--gold),#d69a26);color:#1a1200;box-shadow:0 8px 20px rgba(240,185,64,.25);}
.btn-primary:hover{box-shadow:0 10px 24px rgba(240,185,64,.4);}
.btn-block{width:100%;margin-top:18px;}
.btn-outline{background:transparent;border:1px solid var(--line);color:var(--ink);}
.btn-outline:hover{border-color:var(--blue);}
.btn-ghost{background:var(--navy-700);color:var(--ink-dim);}
.err-msg{color:var(--red);font-size:12px;margin-top:8px;display:none;}

.rules{max-width:700px;margin:36px auto 0;background:rgba(59,125,255,.06);border:1px solid var(--blue-dim);border-radius:var(--radius);padding:18px 22px;}
.rules h4{margin:0 0 10px;font-size:13px;color:var(--blue);text-transform:uppercase;letter-spacing:1px;}
.rules ul{margin:0;padding-left:18px;color:var(--ink-dim);font-size:13px;line-height:1.7;}

/* ============ TEST SCREEN ============ */
#testScreen{display:none;}
.testbar{
  position:sticky;top:0;z-index:40;background:rgba(10,18,38,.96);backdrop-filter:blur(6px);
  border-bottom:1px solid var(--line);
}
.testbar-inner{max-width:1180px;margin:0 auto;padding:10px 18px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;}
.timer-box{
  font-family:var(--font-mono);background:var(--navy-800);border:1px solid var(--line);
  padding:7px 12px;border-radius:9px;font-size:14px;color:var(--gold);display:flex;align-items:center;gap:6px;white-space:nowrap;
}
.score-box{
  font-family:var(--font-mono);background:var(--navy-800);border:1px solid var(--line);
  padding:7px 12px;border-radius:9px;font-size:14px;white-space:nowrap;
}
.score-box b{color:var(--green);}
.subject-nav{display:flex;gap:6px;flex-wrap:wrap;flex:1;justify-content:center;}
.subject-nav button{
  background:var(--navy-800);border:1px solid var(--line);color:var(--ink-dim);
  padding:7px 11px;border-radius:9px;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;
}
.subject-nav button.active{background:var(--blue-dim);border-color:var(--blue);color:#fff;}
.palette-toggle{
  display:none;background:var(--navy-800);border:1px solid var(--line);color:var(--ink);
  padding:7px 12px;border-radius:9px;font-size:12px;cursor:pointer;font-weight:600;
}

.test-body{max-width:1180px;margin:0 auto;padding:20px 18px 60px;display:grid;grid-template-columns:1fr 300px;gap:20px;align-items:start;}
.qcard{background:var(--navy-800);border:1px solid var(--line);border-radius:var(--radius);padding:22px 24px 20px;box-shadow:var(--shadow);}
.qcard-head{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:14px;padding-bottom:14px;border-bottom:1px dashed var(--line);}
.qcard-head .paperline{font-size:11.5px;color:var(--ink-faint);}
.qcard-head .qno{font-family:var(--font-mono);font-weight:700;color:var(--gold);font-size:14px;}
.subject-pill{display:inline-block;font-size:10.5px;font-weight:700;letter-spacing:.5px;padding:3px 9px;border-radius:100px;text-transform:uppercase;}

.qtext{font-size:16.5px;font-weight:600;margin-bottom:4px;line-height:1.6;}
.qtext.te{font-size:16px;font-weight:500;color:var(--ink-dim);margin-bottom:16px;}
.opts{display:flex;flex-direction:column;gap:10px;margin-top:16px;}
.opt{
  display:flex;align-items:flex-start;gap:12px;background:var(--navy-700);
  border:1.5px solid var(--line);border-radius:11px;padding:12px 14px;cursor:pointer;
  transition:border-color .12s, background .12s;
}
.opt:hover{border-color:var(--blue);}
.opt .tag{
  flex:0 0 26px;height:26px;border-radius:50%;background:var(--navy-600);
  display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:var(--ink-dim);
}
.opt .otext{flex:1;font-size:14.5px;}
.opt .otext .te{display:block;font-size:13.5px;color:var(--ink-faint);margin-top:2px;}
.opt.correct{border-color:var(--green);background:rgba(34,199,116,.12);}
.opt.correct .tag{background:var(--green);color:#04220f;}
.opt.wrong{border-color:var(--red);background:rgba(255,84,104,.12);}
.opt.wrong .tag{background:var(--red);color:#2a0006;}
.opt.locked{cursor:default;}
.opt.locked:hover{border-color:var(--line);}
.opt.correct:hover, .opt.wrong:hover{border-color:var(--green);}
.opt.wrong:hover{border-color:var(--red);}

.qcard-nav{display:flex;justify-content:space-between;align-items:center;margin-top:22px;gap:10px;}
.qcard-nav .right-btns{display:flex;gap:10px;}

/* palette sidebar */
.palette{background:var(--navy-800);border:1px solid var(--line);border-radius:var(--radius);padding:18px;position:sticky;top:76px;max-height:calc(100vh - 96px);overflow-y:auto;}
.palette h4{margin:0 0 12px;font-size:12px;text-transform:uppercase;letter-spacing:1px;color:var(--ink-faint);}
.legend{display:flex;flex-wrap:wrap;gap:10px;font-size:10.5px;color:var(--ink-faint);margin-bottom:14px;}
.legend span{display:inline-flex;align-items:center;gap:5px;}
.legend i{width:10px;height:10px;border-radius:3px;display:inline-block;}
.pal-group{margin-bottom:14px;}
.pal-group .glabel{font-size:11px;font-weight:700;color:var(--ink-dim);margin-bottom:7px;}
.pal-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;}
.pal-btn{
  aspect-ratio:1/1;border-radius:7px;border:1.5px solid var(--line);background:var(--navy-700);
  color:var(--ink-dim);font-size:11px;font-family:var(--font-mono);font-weight:600;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
}
.pal-btn.answered{background:var(--blue-dim);border-color:var(--blue);color:#fff;}
.pal-btn.skipped{background:var(--yellow-dim);border-color:var(--yellow);color:#fff;}
.pal-btn.current{outline:2px solid var(--gold);outline-offset:1px;}
.submit-final{width:100%;margin-top:6px;}

.palette-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:60;display:none;}
.palette-overlay .palette{position:absolute;right:0;top:0;bottom:0;width:300px;max-height:none;border-radius:0;}

/* ============ RESULT SCREEN ============ */
#resultScreen{display:none;padding:34px 0 70px;}
.result-hero{text-align:center;padding:10px 18px 6px;}
.result-hero .eyebrow{color:var(--green);}
.score-ring{
  width:150px;height:150px;border-radius:50%;margin:20px auto 8px;display:flex;align-items:center;justify-content:center;
  background:conic-gradient(var(--gold) calc(var(--pct)*1%), var(--navy-700) 0);
  position:relative;
}
.score-ring::before{content:"";position:absolute;inset:9px;border-radius:50%;background:var(--navy-900);}
.score-ring .val{position:relative;font-family:var(--font-mono);font-size:26px;font-weight:800;color:var(--ink);}
.score-ring .sub{position:relative;font-size:11px;color:var(--ink-faint);margin-top:2px;}

.result-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;max-width:760px;margin:22px auto 0;}
.result-stats .rc{background:var(--navy-800);border:1px solid var(--line);border-radius:var(--radius);padding:14px 8px;text-align:center;}
.result-stats .rc .num{font-family:var(--font-mono);font-size:21px;font-weight:700;}
.result-stats .rc .lbl{font-size:11px;color:var(--ink-faint);margin-top:3px;}
.result-stats .rc.correct .num{color:var(--green);}
.result-stats .rc.wrong .num{color:var(--red);}
.result-stats .rc.skip .num{color:var(--yellow);}

.subject-breakdown{max-width:760px;margin:26px auto 0;background:var(--navy-800);border:1px solid var(--line);border-radius:var(--radius);padding:18px 20px;}
.subject-breakdown h4{margin:0 0 12px;font-size:12px;text-transform:uppercase;letter-spacing:1px;color:var(--ink-faint);}
.sb-row{display:grid;grid-template-columns:1.4fr .6fr 2fr;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid var(--line);font-size:13px;}
.sb-row:last-child{border-bottom:none;}
.sb-bar-track{background:var(--navy-700);border-radius:100px;height:8px;overflow:hidden;}
.sb-bar-fill{height:100%;border-radius:100px;background:linear-gradient(90deg,var(--blue),var(--green));}

.action-row{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;max-width:760px;margin:28px auto 0;}

.section-block{max-width:900px;margin:34px auto 0;}
.section-block h3{font-size:14px;text-transform:uppercase;letter-spacing:1.2px;color:var(--ink-faint);margin-bottom:14px;text-align:center;}

/* leaderboard */
.lb-table{width:100%;border-collapse:collapse;background:var(--navy-800);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;}
.lb-table th{background:var(--navy-700);text-align:left;padding:10px 12px;font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--ink-faint);}
.lb-table td{padding:9px 12px;font-size:13.5px;border-top:1px solid var(--line);}
.lb-table tr.me{background:rgba(240,185,64,.1);}
.lb-rank{font-family:var(--font-mono);color:var(--gold);font-weight:700;}
.lb-status{text-align:center;color:var(--ink-faint);font-size:13px;padding:22px 10px;}

/* answer key */
.key-card{background:var(--navy-800);border:1px solid var(--line);border-radius:12px;padding:16px 18px;margin-bottom:12px;}
.key-card .khead{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;flex-wrap:wrap;gap:6px;}
.key-card .kq{font-size:14.5px;font-weight:600;margin-bottom:2px;}
.key-card .kq.te{font-size:13.5px;color:var(--ink-dim);font-weight:500;margin-bottom:10px;}
.key-opts{display:flex;flex-direction:column;gap:6px;}
.key-opt{padding:8px 12px;border-radius:8px;background:var(--navy-700);border:1.5px solid var(--line);font-size:13.5px;display:flex;gap:8px;}
.key-opt .otext .te{display:block;color:var(--ink-faint);font-size:12.5px;}
.key-opt.correct{border-color:var(--green);background:rgba(34,199,116,.12);}
.key-opt.userwrong{border-color:var(--red);background:rgba(255,84,104,.12);}
.key-badge{font-size:10.5px;padding:2px 8px;border-radius:100px;font-weight:700;}
.key-badge.ok{background:var(--green-dim);color:#bdf7d8;}
.key-badge.no{background:var(--red-dim);color:#ffd6db;}
.key-badge.na{background:var(--navy-700);color:var(--ink-faint);}

.footer-credit{text-align:center;color:var(--ink-faint);font-size:12px;margin-top:40px;padding:20px 0;border-top:1px solid var(--line);}
.footer-credit b{color:var(--ink-dim);}
.footer-credit a{color:var(--gold);text-decoration:none;}

/* modal */
.modal-back{position:fixed;inset:0;background:rgba(0,0,0,.65);display:none;align-items:center;justify-content:center;z-index:80;padding:20px;}
.modal-box{background:var(--navy-800);border:1px solid var(--line);border-radius:var(--radius);padding:24px;max-width:400px;width:100%;text-align:center;}
.modal-box h4{margin:0 0 10px;font-size:16px;}
.modal-box p{color:var(--ink-dim);font-size:13.5px;margin-bottom:18px;}
.modal-btns{display:flex;gap:10px;justify-content:center;}

@media(max-width:900px){
  .stat-row{grid-template-columns:repeat(2,1fr);}
  .subject-grid{grid-template-columns:repeat(3,1fr);}
  .test-body{grid-template-columns:1fr;}
  .palette{display:none;}
  .palette-toggle{display:inline-flex;}
  .palette-overlay.show{display:block;}
  .palette-overlay .palette{display:block;}
  .result-stats{grid-template-columns:repeat(2,1fr);}
  .sb-row{grid-template-columns:1fr;}
}
</style>
</head>
